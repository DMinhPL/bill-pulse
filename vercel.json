{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/scan", "destination": "/index.html" },
    { "source": "/prices", "destination": "/index.html" },
    { "source": "/categories/:path*", "destination": "/index.html" },
    { "source": "/bills/:path*", "destination": "/index.html" },
    { "source": "/items/:path*", "destination": "/index.html" }
  ]
}
